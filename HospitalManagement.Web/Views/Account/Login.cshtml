@model LoginViewModel
@{ Layout="_Layout"; ViewData["Title"]="Login"; }
<div data-page="login">
<div class="login-page">
  <div class="login-hero">
    <div class="hero-overlay">
      <div class="brand login-brand"><span class="brand-icon">✚</span><div><div class="brand-title">MediCare</div><div class="brand-subtitle">Hospital Management</div></div></div>
      <h1>Care Today<br/>For A Healthier Tomorrow</h1>
      <p>Trusted healthcare management for your hospital team.</p>
      <div class="quote">“Good health is the foundation of a brighter tomorrow.”</div>
    </div>
  </div>
  <div class="login-panel">
    <div class="login-card">
      <h2>Welcome Back</h2>
      <p class="text-muted">Sign in to continue to MediCare</p>
      <div id="loginError" class="alert alert-danger d-none"></div>
      <form id="loginForm" novalidate>
        <div class="form-floating mb-1">
          <input asp-for="Username" class="form-control" placeholder="Username" required/>
          <label asp-for="Username">Username</label>
        </div>
        <div class="field-error" data-error-for="Username"></div>
        <div class="form-floating mb-1 mt-3">
          <input asp-for="Password" type="password" class="form-control" placeholder="Password" required/>
          <label asp-for="Password">Password</label>
        </div>
        <div class="field-error" data-error-for="Password"></div>
        <button type="submit" class="btn btn-primary w-100 py-3 mt-3">Sign In</button>
      </form>
      <div class="demo-login mt-4">Demo: <b>admin</b> / <b>admin123</b></div>
    </div>
  </div>
</div>
</div>
