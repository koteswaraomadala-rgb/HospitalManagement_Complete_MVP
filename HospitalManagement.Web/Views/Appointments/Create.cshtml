@model AppointmentViewModel
@{ ViewData["Title"]=Model.Id==0?"Book Appointment":"Edit Appointment"; }<div data-page="appointment-form"><div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Schedule or update a patient visit.</p></div><a class="btn btn-light" asp-action="Index">Back</a></div><div class="card-panel form-card"><form id="appointmentForm" data-id="@Model.Id"><div class="row g-3"><div class="col-md-6"><label>Patient</label><select id="PatientId" name="PatientId" class="form-select" required></select><div class="field-error" data-error-for="PatientId"></div></div><div class="col-md-6"><label>Doctor</label><select id="DoctorId" name="DoctorId" class="form-select" required></select><div class="field-error" data-error-for="DoctorId"></div></div><div class="col-md-6"><label>Date</label><input name="AppointmentDate" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" type="date" class="form-control" required/><div class="field-error" data-error-for="AppointmentDate"></div></div><div class="col-md-6"><label>Time</label><select name="AppointmentTime" class="form-select" required><option>09:00 AM</option><option>10:00 AM</option><option>11:00 AM</option><option>02:00 PM</option><option>04:00 PM</option></select><div class="field-error" data-error-for="AppointmentTime"></div></div><div class="col-md-6"><label>Status</label><select name="Status" class="form-select" required><option>Confirmed</option><option>Waiting</option><option>Completed</option><option>Cancelled</option></select><div class="field-error" data-error-for="Status"></div></div><div class="col-12"><label>Reason for Visit</label><textarea name="Reason" class="form-control" required>@Model.Reason</textarea><div class="field-error" data-error-for="Reason"></div></div></div><button class="btn btn-primary mt-4">Save Appointment</button></form></div></div>
