@model List<AppointmentViewModel>
@{ ViewData["Title"] = "Appointments"; }
<div class="page-title"><div><h1>Appointments</h1><p>Manage patient appointments.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Book Appointment</a></div>
<div class="card-panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Doctor</th><th>Reason</th><th>Status</th></tr></thead><tbody>
@foreach(var a in Model){<tr><td>@a.AppointmentDate.ToString("dd MMM yyyy")</td><td>@a.AppointmentTime</td><td>@a.PatientName</td><td>@a.DoctorName</td><td>@a.Reason</td><td><span class="badge-soft">@a.Status</span></td></tr>}
</tbody></table></div></div>
