@{ ViewData["Title"]="Dashboard"; }
<div data-page="dashboard"><div class="page-title"><div><h1>Dashboard</h1><p>Overview of today's hospital activity.</p></div></div><div class="stats-grid"><div class="stat-card blue"><span class="stat-icon"><i class="bi bi-people"></i></span><div><small>Total Patients</small><strong id="statPatients">0</strong></div></div><div class="stat-card green"><span class="stat-icon"><i class="bi bi-person-badge"></i></span><div><small>Total Doctors</small><strong id="statDoctors">0</strong></div></div><div class="stat-card orange"><span class="stat-icon"><i class="bi bi-calendar-event"></i></span><div><small>Today's Appointments</small><strong id="statAppointments">0</strong></div></div><div class="stat-card purple"><span class="stat-icon"><i class="bi bi-capsule"></i></span><div><small>Pending Prescriptions</small><strong id="statPrescriptions">0</strong></div></div></div><div class="card-panel mt-4"><div class="panel-head"><h3>Today's Appointments</h3><a asp-controller="Appointments" asp-action="Index">View All</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Reason</th><th>Status</th></tr></thead><tbody id="dashboardRows"></tbody></table></div></div></div>
