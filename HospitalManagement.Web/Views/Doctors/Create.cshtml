@model DoctorViewModel
@{ ViewData["Title"]=Model.Id==0?"Add Doctor":"Edit Doctor"; }<div data-page="doctor-form"><div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Create or update a doctor profile.</p></div><a class="btn btn-light" asp-action="Index">Back</a></div><div class="card-panel form-card"><form id="doctorForm" data-id="@Model.Id"><div class="row g-3"><div class="col-md-6"><label>Name</label><input name="Name" value="@Model.Name" class="form-control" required/><div class="field-error" data-error-for="Name"></div></div><div class="col-md-6"><label>Specialization</label><input name="Specialization" value="@Model.Specialization" class="form-control" required/><div class="field-error" data-error-for="Specialization"></div></div><div class="col-md-6"><label>Department</label><input name="Department" value="@Model.Department" class="form-control" required/><div class="field-error" data-error-for="Department"></div></div><div class="col-md-6"><label>Experience Years</label><input name="ExperienceYears" value="@Model.ExperienceYears" type="number" min="0" max="70" class="form-control" required/><div class="field-error" data-error-for="ExperienceYears"></div></div><div class="col-md-6"><label>Phone</label><input name="Phone" value="@Model.Phone" class="form-control" required/><div class="field-error" data-error-for="Phone"></div></div><div class="col-md-6"><label>Email</label><input name="Email" value="@Model.Email" type="email" class="form-control"/><div class="field-error" data-error-for="Email"></div></div></div><button class="btn btn-primary mt-4">Save Doctor</button></form></div></div>
