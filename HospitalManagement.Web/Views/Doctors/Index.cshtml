@{ ViewData["Title"] = "Doctors"; }
<div data-page="doctors">
    <div class="page-title">
        <div><h1>Doctors</h1><p>Hospital doctors and specializations.</p></div>
        <button type="button" class="btn btn-primary" id="openDoctorModal"><i class="bi bi-plus-lg"></i> Add Doctor</button>
    </div>
    <div id="doctorGrid" class="doctor-grid"><div class="empty-state">Loading doctors...</div></div>
</div>

<div class="modal fade" id="doctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header"><div><h5 class="modal-title" id="doctorModalTitle">Add Doctor</h5><small class="text-muted">Create or update a doctor profile.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form id="doctorForm" data-id="0" novalidate>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="DoctorName">Name</label><input id="DoctorName" name="Name" class="form-control" required maxlength="100" autocomplete="name"><div class="field-error" data-error-for="Name"></div></div>
                        <div class="col-md-6"><label class="form-label" for="DoctorSpecialization">Specialization</label><input id="DoctorSpecialization" name="Specialization" class="form-control" required maxlength="100"><div class="field-error" data-error-for="Specialization"></div></div>
                        <div class="col-md-6"><label class="form-label" for="DoctorDepartment">Department</label><input id="DoctorDepartment" name="Department" class="form-control" required maxlength="100"><div class="field-error" data-error-for="Department"></div></div>
                        <div class="col-md-6"><label class="form-label" for="DoctorExperienceYears">Experience Years</label><input id="DoctorExperienceYears" name="ExperienceYears" type="number" min="0" max="70" class="form-control" required><div class="field-error" data-error-for="ExperienceYears"></div></div>
                        <div class="col-md-6"><label class="form-label" for="DoctorPhone">Phone</label><input id="DoctorPhone" name="Phone" type="tel" class="form-control" required autocomplete="tel"><div class="field-error" data-error-for="Phone"></div></div>
                        <div class="col-md-6"><label class="form-label" for="DoctorEmail">Email</label><input id="DoctorEmail" name="Email" type="email" class="form-control" autocomplete="email"><div class="field-error" data-error-for="Email"></div></div>
                    </div>
                    <div id="doctorFormError" class="alert alert-danger d-none mt-3 mb-0"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" id="saveDoctorButton"><i class="bi bi-check2"></i> Save Doctor</button></div>
            </form>
        </div>
    </div>
</div>
