@model PatientViewModel
@{ ViewData["Title"]=Model.Id==0?"Add Patient":"Edit Patient"; }<div data-page="patient-form"><div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Create or update a patient record.</p></div><a class="btn btn-light" asp-action="Index">Back</a></div><div class="card-panel form-card"><form id="patientForm" data-id="@Model.Id"><div class="row g-3"><div class="col-md-6"><label>First Name</label><input name="FirstName" value="@Model.FirstName" class="form-control" required/><div class="field-error" data-error-for="FirstName"></div></div><div class="col-md-6"><label>Last Name</label><input name="LastName" value="@Model.LastName" class="form-control" required/><div class="field-error" data-error-for="LastName"></div></div><div class="col-md-4"><label>Gender</label><select name="Gender" class="form-select" required><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select><div class="field-error" data-error-for="Gender"></div></div><div class="col-md-4"><label>Date of Birth</label><input name="DateOfBirth" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" type="date" class="form-control" required/><div class="field-error" data-error-for="DateOfBirth"></div></div><div class="col-md-4"><label>Status</label><select name="Status" class="form-select" required><option>Active</option><option>Inactive</option></select><div class="field-error" data-error-for="Status"></div></div><div class="col-md-6"><label>Phone</label><input name="Phone" value="@Model.Phone" class="form-control" required/><div class="field-error" data-error-for="Phone"></div></div><div class="col-md-6"><label>Email</label><input name="Email" value="@Model.Email" type="email" class="form-control"/><div class="field-error" data-error-for="Email"></div></div><div class="col-12"><label>Address</label><textarea name="Address" class="form-control">@Model.Address</textarea><div class="field-error" data-error-for="Address"></div></div></div><button class="btn btn-primary mt-4">Save Patient</button></form></div></div>
