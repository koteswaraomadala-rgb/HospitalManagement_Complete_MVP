@{ ViewData["Title"] = "Patients"; }
<div data-page="patients">
    <div class="page-title">
        <div><h1>Patients</h1><p>Manage patient registrations and records.</p></div>
        <button type="button" class="btn btn-primary" id="openPatientModal"><i class="bi bi-plus-lg"></i> Add Patient</button>
    </div>

    <div class="card-panel">
        <form id="patientSearchForm" class="filter-row mb-3" novalidate>
            <input id="patientSearch" class="form-control" placeholder="Search by name, phone or patient ID" autocomplete="off" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
        </form>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>#</th><th>Patient ID</th><th>Name</th><th>Gender</th><th>Phone</th><th>DOB</th><th>Status</th><th></th></tr></thead>
                <tbody id="patientRows"><tr><td colspan="8" class="text-center py-4 text-muted">Loading patients...</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="patientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div><h5 class="modal-title" id="patientModalTitle">Add Patient</h5><small class="text-muted">Create or update a patient record.</small></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="patientForm" data-id="0" novalidate>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="PatientFirstName">First Name</label><input id="PatientFirstName" name="FirstName" class="form-control" required maxlength="50" autocomplete="given-name"><div class="field-error" data-error-for="FirstName"></div></div>
                        <div class="col-md-6"><label class="form-label" for="PatientLastName">Last Name</label><input id="PatientLastName" name="LastName" class="form-control" required maxlength="50" autocomplete="family-name"><div class="field-error" data-error-for="LastName"></div></div>
                        <div class="col-md-4"><label class="form-label" for="PatientGender">Gender</label><select id="PatientGender" name="Gender" class="form-select" required><option value="">Select</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select><div class="field-error" data-error-for="Gender"></div></div>
                        <div class="col-md-4"><label class="form-label" for="PatientDateOfBirth">Date of Birth</label><input id="PatientDateOfBirth" name="DateOfBirth" type="date" class="form-control" required><div class="field-error" data-error-for="DateOfBirth"></div></div>
                        <div class="col-md-4"><label class="form-label" for="PatientStatus">Status</label><select id="PatientStatus" name="Status" class="form-select" required><option value="Active">Active</option><option value="Inactive">Inactive</option></select><div class="field-error" data-error-for="Status"></div></div>
                        <div class="col-md-6"><label class="form-label" for="PatientPhone">Phone</label><input id="PatientPhone" name="Phone" type="tel" class="form-control" required autocomplete="tel"><div class="field-error" data-error-for="Phone"></div></div>
                        <div class="col-md-6"><label class="form-label" for="PatientEmail">Email</label><input id="PatientEmail" name="Email" type="email" class="form-control" autocomplete="email"><div class="field-error" data-error-for="Email"></div></div>
                        <div class="col-12"><label class="form-label" for="PatientAddress">Address</label><textarea id="PatientAddress" name="Address" class="form-control" rows="3" maxlength="300"></textarea><div class="field-error" data-error-for="Address"></div></div>
                    </div>
                    <div id="patientFormError" class="alert alert-danger d-none mt-3 mb-0"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="savePatientButton"><i class="bi bi-check2"></i> Save Patient</button>
                </div>
            </form>
        </div>
    </div>
</div>
