@{ ViewData["Title"]="Create Prescription"; }<div data-page="prescription-form"><div class="page-title"><div><h1>Create Prescription</h1><p>Add medication details for an appointment.</p></div><a class="btn btn-light" asp-action="Index">Back</a></div><div class="card-panel form-card"><form id="prescriptionForm" data-id="@Model.Id"><div class="row g-3"><div class="col-md-6"><label>Patient</label><select id="PatientId" class="form-select" required></select></div><div class="col-md-6"><label>Doctor</label><select id="DoctorId" class="form-select" required></select></div><div class="col-12"><label>Appointment</label><select id="AppointmentId" class="form-select" required></select></div><div class="col-md-6"><label>Diagnosis</label><input name="Diagnosis" class="form-control" required/><div class="field-error" data-error-for="Diagnosis"></div></div><div class="col-md-6"><label>Medicine</label><input name="MedicineName" class="form-control" required/><div class="field-error" data-error-for="MedicineName"></div></div><div class="col-md-6"><label>Dosage</label><input name="Dosage" class="form-control" placeholder="e.g. 500 mg" required/><div class="field-error" data-error-for="Dosage"></div></div><div class="col-md-6"><label>Frequency</label><input name="Frequency" class="form-control" placeholder="e.g. Twice daily" required/><div class="field-error" data-error-for="Frequency"></div></div><div class="col-md-6"><label>Duration</label><input name="Duration" class="form-control" placeholder="e.g. 5 days" required/><div class="field-error" data-error-for="Duration"></div></div><div class="col-md-6"><label>Instructions</label><input name="Instructions" class="form-control"/><div class="field-error" data-error-for="Instructions"></div></div><div class="col-12"><label>Notes</label><textarea name="Notes" class="form-control"></textarea><div class="field-error" data-error-for="Notes"></div></div></div><button class="btn btn-primary mt-4">Save Prescription</button></form></div></div>
