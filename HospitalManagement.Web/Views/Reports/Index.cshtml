@{ ViewData["Title"]="Reports"; }<div data-page="reports"><div class="page-title"><div><h1>Reports</h1><p>Review hospital activity for a selected period.</p></div></div><div class="card-panel mb-4"><form id="reportForm" class="row g-3"><div class="col-md-5"><label>From</label><input name="From" type="date" class="form-control" required/><div class="field-error" data-error-for="From"></div></div><div class="col-md-5"><label>To</label><input name="To" type="date" class="form-control" required/><div class="field-error" data-error-for="To"></div></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Generate</button></div></form></div><div id="reportCards" class="stats-grid"></div><div class="card-panel mt-4"><p id="reportMeta" class="mb-0 text-muted"></p></div></div><script>document.addEventListener('DOMContentLoaded',()=>{const f=document.getElementById('reportForm');const d=new Date(),from=new Date();from.setDate(d.getDate()-29);f.From.value=from.toISOString().slice(0,10);f.To.value=d.toISOString().slice(0,10);});</script>
