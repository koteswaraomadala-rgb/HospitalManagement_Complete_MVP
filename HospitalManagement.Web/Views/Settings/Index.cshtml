@{ ViewData["Title"]="Settings"; }<div data-page="settings"><div class="page-title"><div><h1>Settings</h1><p>Manage hospital information, your profile and password.</p></div></div><div class="row g-4"><div class="col-lg-7"><div class="card-panel"><div class="panel-head"><h3>Hospital Settings</h3></div><form id="settingsForm"><div class="mb-3"><label>Hospital Name</label><input name="HospitalName" class="form-control" required/><div class="field-error" data-error-for="HospitalName"></div></div><div class="row g-3"><div class="col-md-6"><label>Contact Email</label><input name="ContactEmail" type="email" class="form-control"/><div class="field-error" data-error-for="ContactEmail"></div></div><div class="col-md-6"><label>Contact Phone</label><input name="ContactPhone" class="form-control"/><div class="field-error" data-error-for="ContactPhone"></div></div></div><div class="mt-3"><label>Address</label><textarea name="Address" class="form-control"></textarea><div class="field-error" data-error-for="Address"></div></div><button class="btn btn-primary mt-3">Save Settings</button></form></div><div class="card-panel mt-4"><div class="panel-head"><h3>My Profile</h3></div><form id="profileForm"><div class="mb-3"><label>Username</label><input name="Username" class="form-control" readonly/><div class="field-error" data-error-for="Username"></div></div><div class="mb-3"><label>Full Name</label><input name="FullName" class="form-control" required/><div class="field-error" data-error-for="FullName"></div></div><div class="mb-3"><label>Role</label><input name="Role" class="form-control" readonly/><div class="field-error" data-error-for="Role"></div></div><button class="btn btn-primary">Save Profile</button></form></div></div><div class="col-lg-5"><div class="card-panel"><div class="panel-head"><h3>Change Password</h3></div><form id="passwordForm"><div class="mb-3"><label>Current Password</label><input name="CurrentPassword" type="password" class="form-control" required/><div class="field-error" data-error-for="CurrentPassword"></div></div><div class="mb-3"><label>New Password</label><input name="NewPassword" type="password" class="form-control" minlength="6" required/><div class="field-error" data-error-for="NewPassword"></div></div><div class="mb-3"><label>Confirm New Password</label><input name="ConfirmPassword" type="password" class="form-control" minlength="6" required/><div class="field-error" data-error-for="ConfirmPassword"></div></div><button class="btn btn-primary">Change Password</button></form></div></div></div></div>
