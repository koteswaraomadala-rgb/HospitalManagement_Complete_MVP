<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - MediCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/></head><body>
@if(Context.Session.GetString("Token")!=null){<div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-icon">✚</span><div><div class="brand-title">MediCare</div><div class="brand-subtitle">Hospital Management</div></div></div><nav class="sidebar-nav"><div class="nav-section-title">MAIN MENU</div><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Patients" ? "active" : "")" asp-controller="Patients" asp-action="Index"><i class="bi bi-people"></i><span>Patients</span></a><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Doctors" ? "active" : "")" asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i><span>Doctors</span></a><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar3"></i><span>Appointments</span></a><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Prescriptions" ? "active" : "")" asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-capsule"></i><span>Prescriptions</span></a><div class="nav-section-title mt-4">OTHER</div><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Reports</span></a><a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>Settings</span></a></nav></aside><main class="main-content"><header class="topbar"><div class="search-box"><i class="bi bi-search"></i><input id="globalSearch" placeholder="Search..."/></div><div class="topbar-right"><div class="topbar-user"><div class="topbar-avatar">@Context.Session.GetString("FullName")?.FirstOrDefault()</div><div class="topbar-user-info"><strong>@Context.Session.GetString("FullName")</strong><small>@Context.Session.GetString("Role")</small></div></div><button type="button" class="icon-button" onclick="appLogout()" title="Logout"><i class="bi bi-box-arrow-right"></i></button></div></header><div class="page-content">@RenderBody()</div></main></div>}else{@RenderBody()}<div id="toastHost" class="toast-host"></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/app.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
