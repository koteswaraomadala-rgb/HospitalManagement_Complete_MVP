<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MediCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css?v=3" rel="stylesheet" />
</head>
<body>
@if (Context.Session.GetString("Token") != null)
{
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                <div>
                    <div class="brand-title">MediCare</div>
                    <div class="brand-subtitle">Hospital Management</div>
                </div>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section-title">MAIN MENU</div>
                <a class="nav-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                <a class="nav-item" asp-controller="Patients" asp-action="Index"><i class="bi bi-people"></i><span>Patients</span></a>
                <a class="nav-item" asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i><span>Doctors</span></a>
                <a class="nav-item" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar3"></i><span>Appointments</span></a>
                <a class="nav-item" asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-capsule"></i><span>Prescriptions</span></a>
                <div class="nav-section-title mt-4">ACCOUNT</div>
                <a class="nav-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i><span>Logout</span></a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="user-avatar"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <div class="user-name">@Context.Session.GetString("FullName")</div>
                        <div class="user-role">@Context.Session.GetString("Role")</div>
                    </div>
                </div>
            </div>
        </aside>
        <main class="main-content">
            <header class="topbar">
                <div class="search-box"><i class="bi bi-search"></i><input type="text" placeholder="Search..." /></div>
                <div class="topbar-right">
                    <button class="icon-button" type="button" title="Notifications"><i class="bi bi-bell"></i></button>
                    <div class="topbar-user">
                        <div class="topbar-avatar"><i class="bi bi-person-fill"></i></div>
                        <div class="topbar-user-info">
                            <strong>@Context.Session.GetString("FullName")</strong>
                            <small>@Context.Session.GetString("Role")</small>
                        </div>
                    </div>
                </div>
            </header>
            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    @RenderBody()
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
