<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MediCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
@if (Context.Session.GetString("Token") != null)
{
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-icon">✚</span> MediCare</div>
        <div class="small text-white-50 mb-4">Hospital Management</div>
        <nav>
            <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
            <a asp-controller="Patients" asp-action="Index"><i class="bi bi-people"></i> Patients</a>
            <a asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i> Doctors</a>
            <a asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar3"></i> Appointments</a>
            <a asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-capsule"></i> Prescriptions</a>
            <a href="#"><i class="bi bi-bar-chart"></i> Reports</a>
            <a href="#"><i class="bi bi-gear"></i> Settings</a>
        </nav>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <div class="search-box"><i class="bi bi-search"></i><input placeholder="Search..." /></div>
            <div class="user-menu"><span class="avatar">@Context.Session.GetString("FullName")?.FirstOrDefault()</span><span>@Context.Session.GetString("FullName")<small>@Context.Session.GetString("Role")</small></span><a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i></a></div>
        </header>
        <div class="content">@RenderBody()</div>
    </main>
</div>
}
else
{
    @RenderBody()
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
