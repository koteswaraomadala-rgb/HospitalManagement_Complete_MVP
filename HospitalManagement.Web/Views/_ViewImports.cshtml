@using HospitalManagement.Web
@using HospitalManagement.Web.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Hospital Management</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div>
                    <div class="brand-title">MediCare</div>
                    <div class="brand-subtitle">Hospital Management</div>
                </div>
            </div>

            <nav class="sidebar-nav">

                <div class="nav-section-title">MAIN</div>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="nav-item">
                    <i class="bi bi-people-fill"></i>
                    <span>Patients</span>
                </a>

                <a asp-controller="Doctors"
                   asp-action="Index"
                   class="nav-item">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Doctors</span>
                </a>

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="nav-item">
                    <i class="bi bi-calendar2-week-fill"></i>
                    <span>Appointments</span>
                </a>

                <a asp-controller="Prescriptions"
                   asp-action="Index"
                   class="nav-item">
                    <i class="bi bi-capsule-pill"></i>
                    <span>Prescriptions</span>
                </a>

                <div class="nav-section-title mt-4">ACCOUNT</div>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="nav-item">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <div class="user-name">Hospital Staff</div>
                        <div class="user-role">Administrator</div>
                    </div>
                </div>
            </div>

        </aside>

        <!-- Main -->
        <main class="main-content">

            <!-- Topbar -->
            <header class="topbar">

                <div>
                    <button class="mobile-menu-btn" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="topbar-right">

                    <button class="icon-button">
                        <i class="bi bi-bell"></i>
                    </button>

                    <div class="topbar-user">
                        <div class="topbar-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="topbar-user-info">
                            <strong>Admin</strong>
                            <small>Hospital Staff</small>
                        </div>
                    </div>

                </div>

            </header>

            <!-- Page -->
            <div class="page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>